# ===== APPLICATION SETTINGS =====
ENV=production
DEBUG=false
PORT=8000

# ===== DJANGO SETTINGS =====
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=api.medconnectai.com,localhost,127.0.0.1
DJANGO_DEBUG=false

# ===== DATABASE CONFIGURATION =====
# Format: postgresql+asyncpg://user:password@host:port/dbname?sslmode=require
# Example: postgresql+asyncpg://medconnect:pass@db.postgres.database.azure.com:5432/medconnectai?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/medconnectai

# ===== SECURITY KEYS =====
SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_SECRET=generate-with-openssl-rand-hex-32

# ===== CORS SETTINGS =====
CORS_ORIGINS=https://app.medconnectai.com,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ===== THIRD-PARTY SERVICES =====

# Twilio Configuration (Video Calls)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY=your-twilio-api-key
TWILIO_API_SECRET=your-twilio-api-secret

# Pinecone Configuration (Vector Database for ML)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=medconnectai-embeddings

# Optional: Error Tracking
SENTRY_DSN=

# Optional: Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== FEATURE FLAGS =====
ENABLE_DOCTOR_MATCHING=true
ENABLE_SYMPTOM_PREDICTION=true
ENABLE_CHATBOT=true
ENABLE_VIDEO_CONSULTATIONS=true
ENABLE_LAB_TESTS=true
